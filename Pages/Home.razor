@page "/"
@inject NavigationManager Navigation

<PageTitle>Wild Rose Studio LLC | Photography by Skylar Spitzer</PageTitle>

<div class="announcement">NOW BOOKING 2027 <span>·</span> WEDDINGS, SENIOR PORTRAITS &amp; FAMILY SESSIONS</div>
<header class="site-header">
    <a class="brand" href="@Navigation.BaseUri" aria-label="Wild Rose Studio LLC home">
        <span class="brand-mark">w</span><span class="brand-name">Wild Rose Studio LLC</span>
    </a>
    <nav aria-label="Main navigation">
        <a href="#stories">Portfolio</a><a href="#process">How it works</a><a href="#contact">Contact</a>
        <a class="nav-cta" href="@ContactHref">Book a session</a>
    </nav>
</header>
<main>
    <section class="hero">
        <div class="hero-copy">
            <div class="eyebrow">Photography by Skylar Spitzer</div>
            <h1>Love, life &amp;<br />everything in<br />between.</h1>
            <p>Honest, heartfelt photography for the chapters you'll want to remember. Serving couples, seniors, and families across Central Florida.</p>
            <div class="hero-actions"><a class="button" href="@ContactHref">Tell me your story</a><a class="text-link" href="#stories">Explore the work</a></div>
        </div>
        <div class="hero-image">
            <img src="https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&amp;fit=crop&amp;w=1400&amp;q=85" alt="Newlyweds sharing a quiet moment together outdoors" />
            <div class="image-caption">A little bit of magic, held forever</div>
        </div>
    </section>
    <section class="intro">
        <div class="eyebrow">The heart behind the camera</div>
        <h2>Photos that feel like being there.</h2>
        <p>Not just how it looked, but how it felt. The happy tears, the wind in your hair, the people you love most—let's make something real together.</p>
    </section>
    <section class="collections" id="stories">
        <div class="section-heading">
            <div><div class="eyebrow">A few favorite stories</div><h2>Made to be remembered.</h2></div>
            <a href="@(Navigation.BaseUri + "portfolio")">View the full portfolio ↗</a>
        </div>
        <div class="cards">
            <a class="card" href="@(Navigation.BaseUri + "portfolio/weddings")">
                <img src="https://images.unsplash.com/photo-1537633552985-df8429e8048b?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="Bride and groom celebrating their wedding day" />
                <div class="card-label"><h3>Weddings</h3><p>Big feelings, little details</p></div>
            </a>
            <a class="card" href="@(Navigation.BaseUri + "portfolio/senior-portraits")">
                <img src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="Senior portrait in warm natural light" />
                <div class="card-label"><h3>Senior portraits</h3><p>Your next chapter, your way</p></div>
            </a>
            <a class="card" href="@(Navigation.BaseUri + "portfolio/families")">
                <img src="https://images.unsplash.com/photo-1511895426328-dc8714191300?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="Family enjoying time together outside" />
                <div class="card-label"><h3>Families</h3><p>The beautifully ordinary days</p></div>
            </a>
        </div>
    </section>
    <section class="process" id="process">
        <div class="eyebrow">What to expect</div>
        <h2>Simple from hello to final photos.</h2>
        <ol class="steps">
            <li><span>1</span><h3>Say hello</h3><p>Tell me what you're celebrating, your date, and where. Wedding, senior session, family, or a milestone of your own.</p></li>
            <li><span>2</span><h3>Plan together</h3><p>We talk through locations, timing, and what matters most to you, so the day itself feels easy.</p></li>
            <li><span>3</span><h3>Relive it</h3><p>I edit your photos with care and deliver them for you to share, print, and keep.</p></li>
        </ol>
    </section>
    <section class="quote">
        <div class="eyebrow">Kind words</div>
        <blockquote>“She made us feel so comfortable—and somehow captured the little moments we didn't even realize were happening.”</blockquote>
        <cite>Jamie &amp; Alex · Wedding collection</cite>
    </section>
    <section class="contact" id="contact">
        <div class="eyebrow">Your story starts here</div>
        <h2>Let's make something meaningful.</h2>
        <p>Weddings, senior portraits, families, milestones: tell me what you're celebrating, the date, and where. I'll reply with availability and next steps.</p>
        <a class="button" href="@ContactHref">Email Skylar</a>
    </section>
</main>
<footer>
    <div class="brand-name">Wild Rose Studio LLC · Skylar Spitzer</div>
    <span>Based in Central Florida · Available wherever your story takes us</span>
</footer>

@code {
    // TODO: replace with the real address (see GitHub issue "Set the real contact email").
    private const string ContactEmail = "hello@example.com";
    private const string InquiryBody = "Hi Skylar,\n\nType of session (wedding, senior, family, other):\nDate:\nLocation:\nA little about what we're hoping for:\n";

    private static readonly string ContactHref =
        $"mailto:{ContactEmail}?subject={Uri.EscapeDataString("Photography inquiry")}&body={Uri.EscapeDataString(InquiryBody)}";
}

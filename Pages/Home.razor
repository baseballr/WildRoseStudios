@page "/"
@using System.Text.Json
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>@(IsEditor ? "Studio editor | Wild Rose Studio" : "Wild Rose Studio LLC | Photography by Skylar Spitzer")</PageTitle>

@if (!_isReady)
{
    <div class="app-loading" role="status">Loading Wild Rose Studio…</div>
}
else if (IsEditor)
{
    <section class="editor" aria-label="Studio website editor">
        <div class="editor-top">
            <a class="editor-brand" href="./" aria-label="Wild Rose Studio home">
                <span class="brand-mark">w</span> Wild Rose Studio LLC <span class="editor-badge">Site editor</span>
            </a>
            <div class="editor-top-right">
                <span class="saved-state">@_status</span>
                <a class="text-link" href="./">View website</a>
                <button class="button" type="button" @onclick="PublishAsync">Publish changes</button>
            </div>
        </div>
        <div class="editor-layout">
            <aside class="editor-sidebar" aria-label="Editor navigation">
                <div class="side-label">Manage website</div>
                <div class="side-item active"><span class="side-icon" aria-hidden="true">▧</span> Homepage</div>
                <div class="side-note">Changes are saved in this browser only. The editor is not password-protected.</div>
            </aside>
            <div class="editor-content">
                <div class="eyebrow">Website / Homepage</div>
                <h1>Make it yours.</h1>
                <div class="editor-subtitle">Update your words and photo. Changes appear in the preview as you type.</div>

                @if (!string.IsNullOrWhiteSpace(_storageError))
                {
                    <div class="editor-alert" role="alert">@_storageError</div>
                }

                <section class="editor-card">
                    <div class="editor-card-head">
                        <h2>Hero section</h2>
                        <button class="small-link" type="button" @onclick="ResetDraft">Reset example content</button>
                    </div>
                    <label class="field-label" for="headline">Headline</label>
                    <textarea class="field headline-field" id="headline" @bind="_draft.Headline" @bind:event="oninput" rows="3"></textarea>
                    <label class="field-label" for="description">Short introduction</label>
                    <textarea class="field" id="description" @bind="_draft.Description" @bind:event="oninput" rows="4"></textarea>
                </section>

                <section class="editor-card">
                    <div class="editor-card-head"><h2>Featured photo</h2></div>
                    <div class="upload-box">
                        <img src="@_draft.HeroImage" alt="Current featured wedding photo" />
                        <div class="upload-copy">
                            Upload a JPEG, PNG, WebP, or GIF image up to 500 KB. It will be stored in this browser.
                            <label class="upload-button" for="photo-upload">Choose a photo</label>
                            <InputFile id="photo-upload" class="file-input" accept="image/jpeg,image/png,image/webp,image/gif" OnChange="HandlePhotoSelected" />
                        </div>
                    </div>
                </section>

                <section class="editor-card">
                    <div class="editor-card-head"><h2>Contact details</h2></div>
                    <label class="field-label" for="contact-email">Email address</label>
                    <input class="field" id="contact-email" type="email" autocomplete="email" @bind="_draft.ContactEmail" @bind:event="oninput" />
                    <p class="field-hint">The “Get in touch” button opens an email to this address. Replace the example address before sharing the site.</p>
                </section>

                <section class="editor-card">
                    <div class="editor-card-head"><h2>Featured collections</h2></div>
                    <p class="collection-note">Weddings · Senior portraits · Families</p>
                    <p class="field-hint">These featured galleries are shown on your homepage.</p>
                </section>

                <div class="save-row">
                    <span>@_status</span>
                    <button class="button" type="button" @onclick="SaveDraftAsync">Save draft</button>
                </div>
            </div>
            <aside class="preview-pane" aria-label="Live website preview">
                <div class="preview-heading"><span>Live preview</span><span>Desktop</span></div>
                <div class="preview-frame">
                    <div class="mini-header">Wild Rose Studio LLC</div>
                    <img src="@_draft.HeroImage" alt="" />
                    <div class="mini-body">
                        <div class="mini-eyebrow">Photography by Skylar Spitzer</div>
                        <h3>@_draft.Headline</h3>
                        <p>@_draft.Description</p>
                        <span class="mini-button">Tell me your story</span>
                    </div>
                </div>
            </aside>
        </div>
        @if (!string.IsNullOrWhiteSpace(_photoError))
        {
            <div class="toast error-toast" role="alert">@_photoError</div>
        }
        else if (!string.IsNullOrWhiteSpace(_toast))
        {
            <div class="toast" role="status">@_toast</div>
        }
    </section>
}
else
{
    <div class="announcement">NOW BOOKING WEDDINGS &amp; PORTRAITS FOR 2026 <span>·</span> A FEW DATES LEFT</div>
    <header class="site-header">
        <a class="brand" href="#" aria-label="Wild Rose Studio LLC home">
            <span class="brand-mark">w</span><span class="brand-name">Wild Rose Studio LLC</span>
        </a>
        <nav aria-label="Main navigation">
            <a href="#stories">Portfolio</a><a href="#experience">Experience</a><a href="#about">About</a><a href="#contact">Contact</a>
            <a class="nav-cta" href="#contact">Let's connect</a>
        </nav>
    </header>
    <main>
        <section class="hero" id="about">
            <div class="hero-copy">
                <div class="eyebrow">Photography by Skylar Spitzer</div>
                <h1>@_published.Headline</h1>
                <p>@_published.Description</p>
                <div class="hero-actions"><a class="button" href="#contact">Tell me your story</a><a class="text-link" href="#stories">Explore the work</a></div>
            </div>
            <div class="hero-image">
                <img src="@_published.HeroImage" alt="Newlyweds sharing a quiet moment together outdoors" />
                <div class="image-caption">A little bit of magic, held forever</div>
            </div>
        </section>
        <section class="intro" id="experience">
            <div class="eyebrow">The heart behind the camera</div>
            <h2>Photos that feel like being there.</h2>
            <p>Not just how it looked, but how it felt. The happy tears, the wind in your hair, the people you love most—let's make something real together.</p>
        </section>
        <section class="collections" id="stories">
            <div class="section-heading">
                <div><div class="eyebrow">A few favorite stories</div><h2>Made to be remembered.</h2></div>
                <a href="#contact">View the full portfolio ↗</a>
            </div>
            <div class="cards">
                <a class="card" href="#contact">
                    <img src="https://images.unsplash.com/photo-1537633552985-df8429e8048b?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="Bride and groom celebrating their wedding day" />
                    <div class="card-label"><h3>Weddings</h3><p>Big feelings, little details</p></div>
                </a>
                <a class="card" href="#contact">
                    <img src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="Senior portrait in warm natural light" />
                    <div class="card-label"><h3>Senior portraits</h3><p>Your next chapter, your way</p></div>
                </a>
                <a class="card" href="#contact">
                    <img src="https://images.unsplash.com/photo-1511895426328-dc8714191300?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="Family enjoying time together outside" />
                    <div class="card-label"><h3>Families</h3><p>The beautifully ordinary days</p></div>
                </a>
            </div>
        </section>
        <section class="quote">
            <div class="eyebrow">Kind words</div>
            <blockquote>“She made us feel so comfortable—and somehow captured the little moments we didn't even realize were happening.”</blockquote>
            <cite>Jamie &amp; Alex · Wedding collection</cite>
        </section>
        <section class="contact" id="contact">
            <div class="eyebrow">Your story starts here</div>
            <h2>Let's make something meaningful.</h2>
            <p>Tell me a little about what you're dreaming up. I'd love to hear from you.</p>
            <a class="button" href="@ContactHref">Get in touch</a>
        </section>
    </main>
    <footer>
        <div class="brand-name">Wild Rose Studio LLC · Skylar Spitzer</div>
        <span>Based in Central Florida · Available wherever your story takes us</span>
        <a class="login-link" href="?editor=1">Studio editor</a>
    </footer>
}

@code {
    private const string DraftStorageKey = "wildrose.studio.draft";
    private const string PublishedStorageKey = "wildrose.studio.published";
    private const long MaxPhotoSize = 500_000;
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);

    private SiteContent _published = SiteContent.CreateDefault();
    private SiteContent _draft = SiteContent.CreateDefault();
    private bool _isReady;
    private string _status = "Changes save as a draft until published.";
    private string? _storageError;
    private string? _photoError;
    private string? _toast;

    private bool IsEditor => Navigation.Uri.Contains("?editor=1", StringComparison.OrdinalIgnoreCase)
        || Navigation.Uri.Contains("&editor=1", StringComparison.OrdinalIgnoreCase);

    private string ContactHref => string.IsNullOrWhiteSpace(_published.ContactEmail)
        ? "#contact"
        : $"mailto:{_published.ContactEmail}";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var publishedJson = await JS.InvokeAsync<string?>("localStorage.getItem", PublishedStorageKey);
            _published = DeserializeContent(publishedJson, "published website");

            var draftJson = await JS.InvokeAsync<string?>("localStorage.getItem", DraftStorageKey);
            _draft = draftJson is null ? _published.Clone() : DeserializeContent(draftJson, "saved draft");
        }
        catch (JSException)
        {
            _storageError = "Browser storage is unavailable. Changes cannot be saved in this browser.";
            _draft = _published.Clone();
        }

        _isReady = true;
    }

    private SiteContent DeserializeContent(string? json, string itemName)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return SiteContent.CreateDefault();
        }

        try
        {
            return JsonSerializer.Deserialize<SiteContent>(json, JsonOptions) ?? SiteContent.CreateDefault();
        }
        catch (JsonException)
        {
            _storageError = $"The {itemName} could not be read. Reset the example content and save it again.";
            return SiteContent.CreateDefault();
        }
    }

    private async Task SaveDraftAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", DraftStorageKey, JsonSerializer.Serialize(_draft, JsonOptions));
            _status = "Draft saved in this browser.";
            _storageError = null;
            _toast = "Draft saved on this device";
        }
        catch (JSException)
        {
            _storageError = "Could not save this draft. Browser storage may be full or disabled.";
            _status = "Draft was not saved.";
            _toast = null;
        }
    }

    private async Task PublishAsync()
    {
        try
        {
            var json = JsonSerializer.Serialize(_draft, JsonOptions);
            await JS.InvokeVoidAsync("localStorage.setItem", DraftStorageKey, json);
            await JS.InvokeVoidAsync("localStorage.setItem", PublishedStorageKey, json);
            _published = _draft.Clone();
            _status = "Published in this browser.";
            _storageError = null;
            _toast = "Changes published on this device";
        }
        catch (JSException)
        {
            _storageError = "Could not publish these changes. Browser storage may be full or disabled.";
            _status = "Changes were not published.";
            _toast = null;
        }
    }

    private void ResetDraft()
    {
        _draft = SiteContent.CreateDefault();
        _photoError = null;
        _status = "Example content restored. Save or publish to keep it.";
        _toast = null;
    }

    private async Task HandlePhotoSelected(InputFileChangeEventArgs args)
    {
        _photoError = null;
        _toast = null;
        var file = args.File;
        var allowedTypes = new[] { "image/jpeg", "image/png", "image/webp", "image/gif" };

        if (!allowedTypes.Contains(file.ContentType, StringComparer.OrdinalIgnoreCase))
        {
            _photoError = "Choose a JPEG, PNG, WebP, or GIF image.";
            return;
        }

        if (file.Size > MaxPhotoSize)
        {
            _photoError = "Choose an image smaller than 500 KB.";
            return;
        }

        try
        {
            await using var input = file.OpenReadStream(MaxPhotoSize);
            using var output = new MemoryStream();
            await input.CopyToAsync(output);
            _draft.HeroImage = $"data:{file.ContentType};base64,{Convert.ToBase64String(output.ToArray())}";
            _status = "Photo selected. Save the draft or publish to keep it.";
        }
        catch (IOException)
        {
            _photoError = "The photo could not be read. Please choose another image.";
        }
        catch (JSException)
        {
            _photoError = "The photo could not be loaded in this browser. Please try again.";
        }
    }

    private sealed class SiteContent
    {
        public string Headline { get; set; } = "";
        public string Description { get; set; } = "";
        public string HeroImage { get; set; } = "";
        public string ContactEmail { get; set; } = "";

        public static SiteContent CreateDefault() => new()
        {
            Headline = "Love, life &\neverything in\nbetween.",
            Description = "Honest, heartfelt photography for the chapters you'll want to remember. Serving couples, seniors, and families across Central Florida.",
            HeroImage = "https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1400&q=85",
            ContactEmail = "hello@example.com"
        };

        public SiteContent Clone() => new()
        {
            Headline = Headline,
            Description = Description,
            HeroImage = HeroImage,
            ContactEmail = ContactEmail
        };
    }
}

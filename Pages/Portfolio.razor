@page "/portfolio"
@page "/portfolio/{Category}"
@page "/portfolio/{Category}/{ShootSlug}"
@inject NavigationManager Navigation

<PageTitle>@PageTitleText</PageTitle>

<div class="announcement">WILD ROSE STUDIO LLC <span>·</span> PHOTOGRAPHY BY SKYLAR ROSE</div>
<header class="site-header">
    <a class="brand" href="@Navigation.BaseUri" aria-label="Wild Rose Studio LLC home">
        <span class="brand-mark">w</span><span class="brand-name">Wild Rose Studio LLC</span>
    </a>
    <nav aria-label="Main navigation">
        <a href="@(Navigation.BaseUri + "portfolio")">Portfolio</a>
        <a href="@(Navigation.BaseUri + "#process")">How it works</a>
        <a href="@(Navigation.BaseUri + "#contact")">Contact</a>
        <a class="nav-cta" href="@(Navigation.BaseUri + "#contact")">Book a session</a>
    </nav>
</header>

<main class="portfolio-page">
    @if (Category is null)
    {
        <div class="eyebrow">A few favorite stories</div>
        <h1>Made to be remembered.</h1>
        <p class="portfolio-intro">Pick the kind of session you're planning to see a preview and what to expect.</p>
        <div class="cards">
            @foreach (var album in Albums)
            {
                <a class="card" href="@PortfolioHref(album.Slug)">
                    <img src="@album.Image" alt="@album.ImageDescription" />
                    <div class="card-label"><h2>@album.Title</h2><p>@album.Tagline</p></div>
                </a>
            }
        </div>
    }
    else if (SelectedAlbum is { } parent && ShootSlug is not null)
    {
        if (SelectedShoot is { } shoot)
        {
            <a class="portfolio-back" href="@PortfolioHref(parent.Slug)">← All @parent.Title.ToLower()</a>
            <div class="eyebrow">@parent.Title · @shoot.Subtitle</div>
            <h1>@shoot.Title</h1>
            <p class="portfolio-intro">@shoot.Description</p>
            <div class="gallery">
                @for (var i = 0; i < shoot.Photos.Length; i++)
                {
                    var index = i;
                    var photo = shoot.Photos[i];
                    <button type="button" class="gallery-item" @onclick="() => OpenPhoto(index)" aria-label="View larger: @photo.Alt">
                        <img src="@photo.Thumb" alt="@photo.Alt" loading="lazy" />
                    </button>
                }
            </div>
            <div class="album-cta">
                <p>Planning your own day?</p>
                <a class="button" href="@(Navigation.BaseUri + "#contact")">Ask about @parent.Title.ToLower()</a>
            </div>

            @if (OpenIndex is int open)
            {
                var current = shoot.Photos[open];
                <div class="lightbox" role="dialog" aria-modal="true" aria-label="@shoot.Title photo viewer" @onclick="ClosePhoto">
                    <button type="button" class="lightbox-close" @onclick="ClosePhoto" aria-label="Close">×</button>
                    <button type="button" class="lightbox-nav prev" @onclick="() => StepPhoto(-1, shoot)" @onclick:stopPropagation aria-label="Previous photo">‹</button>
                    <img src="@current.Full" alt="@current.Alt" @onclick:stopPropagation />
                    <button type="button" class="lightbox-nav next" @onclick="() => StepPhoto(1, shoot)" @onclick:stopPropagation aria-label="Next photo">›</button>
                    <div class="lightbox-count">@(open + 1) / @shoot.Photos.Length</div>
                </div>
            }
        }
        else
        {
            <div class="eyebrow">@parent.Title</div>
            <h1>Album not found.</h1>
            <p class="portfolio-intro">That album isn’t available. Browse the other @parent.Title.ToLower() albums instead.</p>
            <a class="button" href="@PortfolioHref(parent.Slug)">Back to @parent.Title.ToLower()</a>
        }
    }
    else if (SelectedAlbum is { } album)
    {
        <a class="portfolio-back" href="@(Navigation.BaseUri + "portfolio")">← All collections</a>
        <div class="eyebrow">@album.Tagline</div>
        <h1>@album.Title</h1>
        <div class="album-feature">
            <img src="@album.Image" alt="@album.ImageDescription" />
            <div class="album-note">
                <h2>A story worth keeping.</h2>
                <p>@album.Blurb</p>
                <a class="button" href="@(Navigation.BaseUri + "#contact")">Ask about @album.Title.ToLower()</a>
            </div>
        </div>
        @if (album.Shoots.Length > 0)
        {
            <section class="shoots" aria-labelledby="shoots-heading">
                <div class="eyebrow">Albums</div>
                <h2 id="shoots-heading">Real @album.Title.ToLower(), start to finish.</h2>
                <div class="cards">
                    @foreach (var shoot in album.Shoots)
                    {
                        <a class="card" href="@($"{PortfolioHref(album.Slug)}/{shoot.Slug}")">
                            <img src="@shoot.Cover.Thumb" alt="@shoot.Cover.Alt" loading="lazy" />
                            <div class="card-label"><h3>@shoot.Title</h3><p>@shoot.Photos.Length photos · View album</p></div>
                        </a>
                    }
                </div>
            </section>
        }
        <nav class="more-albums" aria-label="Other collections">
            <span>Also see:</span>
            @foreach (var other in Albums.Where(a => a.Slug != album.Slug))
            {
                <a href="@PortfolioHref(other.Slug)">@other.Title</a>
            }
        </nav>
    }
    else
    {
        <div class="eyebrow">Portfolio</div>
        <h1>Collection not found.</h1>
        <p class="portfolio-intro">That collection isn’t available. Browse the portfolio to see the featured categories.</p>
        <a class="button" href="@(Navigation.BaseUri + "portfolio")">Browse collections</a>
    }
</main>

<footer>
    <div class="brand-name">Wild Rose Studio LLC · Skylar Rose</div>
    <span>Based in Central Florida · Available wherever your story takes us</span>
</footer>

@code {
    [Parameter]
    public string? Category { get; set; }

    [Parameter]
    public string? ShootSlug { get; set; }

    private int? OpenIndex { get; set; }

    private static readonly Photo SpitzerCover =
        new("images/albums/spitzer-wedding/cover-thumb.jpg", "images/albums/spitzer-wedding/cover-thumb.jpg",
            "Groom dipping the bride for a kiss down the aisle as the wedding party cheers");

    private static readonly Photo[] SpitzerPhotos =
    [
        new("images/albums/spitzer-wedding/01-thumb.jpg", "images/albums/spitzer-wedding/01.jpg",
            "Bride and groom laughing with their officiant during the ring exchange"),
        new("images/albums/spitzer-wedding/02-thumb.jpg", "images/albums/spitzer-wedding/02.jpg",
            "The first kiss beneath a floral arch under stormy skies"),
        new("images/albums/spitzer-wedding/03-thumb.jpg", "images/albums/spitzer-wedding/03.jpg",
            "Groom dipping the bride for a kiss down the aisle in warm evening light"),
        new("images/albums/spitzer-wedding/04-thumb.jpg", "images/albums/spitzer-wedding/04.jpg",
            "Close-up of the couple's hands forming a heart, showing both wedding rings"),
        new("images/albums/spitzer-wedding/05-thumb.jpg", "images/albums/spitzer-wedding/05.jpg",
            "Groom twirling the bride in an open field beneath a dusky sky")
    ];

    private static readonly Album[] Albums =
    [
        new(
            "weddings",
            "Weddings",
            "Big feelings, little details",
            "https://images.unsplash.com/photo-1537633552985-df8429e8048b?auto=format&fit=crop&w=1200&q=85",
            "Bride and groom celebrating their wedding day",
            "From getting ready to the last dance, I focus on the real moments: the nerves, the laughter, the quiet looks between the big ones. Tell me your date and venue and I'll check availability.",
            [
                new(
                    "spitzer-wedding",
                    "The Spitzer Wedding",
                    "Storm skies & cowboy hats",
                    "A country ceremony under rolling storm clouds: laughter through the ring exchange, a first kiss beneath the arch, and one last twirl in the field before the rain.",
                    SpitzerCover,
                    SpitzerPhotos)
            ]),
        new(
            "senior-portraits",
            "Senior portraits",
            "Your next chapter, your way",
            "https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=1200&q=85",
            "Senior portrait in warm natural light",
            "A relaxed session built around you: your favorite places, your style, your people. You'll leave with photos that feel like the person you are right now."),
        new(
            "families",
            "Families",
            "The beautifully ordinary days",
            "https://images.unsplash.com/photo-1511895426328-dc8714191300?auto=format&fit=crop&w=1200&q=85",
            "Family enjoying time together outside",
            "No stiff poses required. Kids, grandparents, and pets welcome. We'll keep it easy and capture how your family really is together.")
    ];

    private Album? SelectedAlbum => Albums.FirstOrDefault(
        album => string.Equals(album.Slug, Category, StringComparison.OrdinalIgnoreCase));

    private Shoot? SelectedShoot => SelectedAlbum?.Shoots.FirstOrDefault(
        shoot => string.Equals(shoot.Slug, ShootSlug, StringComparison.OrdinalIgnoreCase));

    private string PageTitleText =>
        SelectedShoot is { } shoot ? $"{shoot.Title} | Wild Rose Studio"
        : SelectedAlbum is { } album && ShootSlug is null ? $"{album.Title} | Wild Rose Studio"
        : "Portfolio | Wild Rose Studio";

    protected override void OnParametersSet() => OpenIndex = null;

    private void OpenPhoto(int index) => OpenIndex = index;

    private void ClosePhoto() => OpenIndex = null;

    private void StepPhoto(int delta, Shoot shoot)
    {
        if (OpenIndex is int index)
        {
            OpenIndex = (index + delta + shoot.Photos.Length) % shoot.Photos.Length;
        }
    }

    private string PortfolioHref(string slug) => $"{Navigation.BaseUri}portfolio/{slug}";

    private sealed record Album(string Slug, string Title, string Tagline, string Image, string ImageDescription, string Blurb, Shoot[]? ShootList = null)
    {
        public Shoot[] Shoots => ShootList ?? [];
    }

    private sealed record Shoot(string Slug, string Title, string Subtitle, string Description, Photo Cover, Photo[] Photos);

    private sealed record Photo(string Thumb, string Full, string Alt);
}
